rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUserProfile(userId) {
      return request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && isUserProfile(userId);
    }

    // Events collection
    match /events/{eventId} {
      // Allow reading all events for authenticated users
      allow read: if isAuthenticated();
      
      // Allow creating new events
      allow create: if isAuthenticated() && (
        // Creator must be the current user
        request.resource.data.createdBy == request.auth.uid &&
        // Current user must be in collaborators
        request.auth.uid in request.resource.data.collaborators
      );
      
      // Allow updating existing events
      allow update: if isAuthenticated() && (
        // Must be creator or collaborator
        request.auth.uid == resource.data.createdBy ||
        request.auth.uid in resource.data.collaborators
      );
      
      // Allow deleting events
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.createdBy
      );
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.assignees ||
        resource.data.createdBy == request.auth.uid
      );
      allow write: if isAuthenticated() && (
        request.auth.uid in request.resource.data.assignees ||
        request.resource.data.createdBy == request.auth.uid
      );
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow write: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
  }
}
